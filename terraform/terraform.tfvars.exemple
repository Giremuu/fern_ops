project_name = "fernops"
environment  = "lab"

tags = {
  Owner = "Gwilherm"
}

aws_region        = "???"
availability_zone = "???"

# VPC ID
aws_vpc_id = "vpc-xxxxxxxxxxxxxxxxx"

public_subnet_cidr_block  = "X.X.X.X/24"
private_subnet_cidr_block = "X.X.X.X/24"

ssh_cidr_blocks = ["0.0.0.0/0"]     # Warning : All over Internet can SSH