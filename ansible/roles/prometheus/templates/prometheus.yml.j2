global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: 'nginx'
    static_configs:
      - targets: ['{{ hostvars["nginx-host"]["ansible_default_ipv4"]["address"] }}:9100']
        labels:
          instance: 'nginx'

  - job_name: 'prometheus-grafana'
    static_configs:
      - targets: ['localhost:9100']
        labels:
          instance: 'prometheus-grafana'

  - job_name: 'uptime-kuma'
    static_configs:
      - targets: ['{{ hostvars["uptime-kuma"]["ansible_default_ipv4"]["address"] }}:9100']
        labels:
          instance: 'uptime-kuma'
