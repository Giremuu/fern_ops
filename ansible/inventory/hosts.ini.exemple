[nginx]
nginx-host ansible_host=NGINX_PUBLIC_IP

[monitoring]
prometheus-grafana ansible_host=PROMETHEUS_GRAFANA_PRIVATE_IP

[uptime_kuma]
uptime-kuma ansible_host=UPTIME_KUMA_PRIVATE_IP

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/YOUR_KEY.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[monitoring:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyJump=ubuntu@NGINX_PUBLIC_IP'

[uptime_kuma:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyJump=ubuntu@NGINX_PUBLIC_IP'